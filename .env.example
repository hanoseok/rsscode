# Discord OAuth2 credentials (from Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# RSS check interval in minutes (1-1440)
CHECK_INTERVAL_MINUTES=10

# Database path
DATABASE_URL=./data/rsscode.db

# Server port
PORT=3000

# Session signing secret (REQUIRED in production)
SESSION_SECRET=

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com)
# Leave empty to allow all origins (dev only)
ALLOWED_ORIGINS=

# Initial password for the bootstrap "admin" user (only used on first DB creation).
# If unset, a random password is generated and printed to the server log once.
ADMIN_INITIAL_PASSWORD=
